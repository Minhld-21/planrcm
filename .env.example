# Public URL dùng để tạo canonical URL, robots.txt và sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Next.js proxy /api/* tới backend này. Không expose biến này cho browser.
BACKEND_URL=http://localhost:3000

# Có thể là /api/v1 (mặc định, dùng proxy) hoặc một URL API đầy đủ.
NEXT_PUBLIC_API_BASE_URL=/api/v1
